{
  "name": "frontend",
  "description": "Svelte renderer for ShindenToAnilist.",
  "private": true,
  "author": "Kacper Kondracki",
  "license": "MPL-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:errors": "node --test --test-isolation=none tests/errors.test.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "proto:gen": "buf generate --template ../buf.gen.yaml ../proto",
    "format": "prettier --ignore-path ../.prettierignore --write .",
    "format:check": "prettier --ignore-path ../.prettierignore --check ."
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.3.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.75.0",
    "@bufbuild/protoc-gen-es": "^2.17.0",
    "@catppuccin/daisyui": "^2.1.1",
    "@iconify-json/lucide": "^1.2.156",
    "@iconify/tailwind4": "^1.2.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "daisyui": "^5.8.1",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.58.0",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "virtua": "^0.49.3",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.17.0",
    "@connectrpc/connect": "^2.3.0",
    "@connectrpc/connect-web": "^2.3.0",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.3"
  }
}
